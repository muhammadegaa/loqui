# Firebase client (public — already set on Vercel)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Flip to "true" once R2 + the service account below are configured.
NEXT_PUBLIC_DOWNLOAD_READY=false

# Optional: footer/nav "buy me a coffee" link (defaults to buymeacoffee.com/egglabs)
NEXT_PUBLIC_BMC_URL=

# Firebase Admin (SERVER ONLY — verifies the download caller + writes the rate-limit
# counter). Paste the whole service-account JSON, or its base64.
FIREBASE_SERVICE_ACCOUNT=

# Cloudflare R2 (SERVER ONLY — the release bucket the signed download points at)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loqui-releases
R2_OBJECT_KEY=Loqui.dmg
